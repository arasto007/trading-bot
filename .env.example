# MT5 credentials (required for live trading and data collection)
# Copy this file to .env and fill in your values.
# Do NOT commit .env to version control.

MT5_LOGIN=your_account_number
MT5_PASSWORD=your_password
MT5_SERVER=your_broker_server

# LIVE kernel (dashboard) — VOL_REGIME only
USE_ML_KERNEL=false

# Phase 2 — Telegram alerts (OPTIONAL — bot runs without these)
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=

# Block real MT5 account on LIVE unless you explicitly allow (default: demo only)
# TRADINGBOT_ALLOW_REAL=1

# Daily report hour (UTC) when bot is running
LIVE_DAILY_REPORT_HOUR_UTC=20
# Drift vs backtest alert hour (UTC) — Telegram when status warn/critical
LIVE_DRIFT_CHECK_HOUR_UTC=21

# Phase 4 — prop-firm risk preset (optional: ftmo, conservative, or leave unset)
# TRADINGBOT_PROP_PRESET=ftmo
TREND_MODEL_VERSION=v41
ENABLE_RSI_FILTER=true
ENABLE_ADX_FILTER=true
RSI_MIN=40
RSI_MAX=60
ADX_MIN=15
ADX_MAX=50

# Phase 22C — profitability recovery (optional overrides)
PHASE22C_ENABLED=true
PHASE22C_DECISION_MIN_CONFIDENCE=0.48
PHASE22C_QUALITY_THRESHOLD=0.52
PHASE22C_CALIBRATION_MIN_CONFIDENCE=0.42
PHASE22C_RANGE_BUY_THRESHOLD=0.52
PHASE22C_RANGE_SELL_THRESHOLD=0.48
PHASE22C_RSI_MIN=35
PHASE22C_RSI_MAX=65
PHASE22C_ADX_MIN=10
PHASE22C_ADX_MAX=55
PHASE22C_DAILY_LOSS_FLOOR_TRADES=3
PHASE22C_USE_DAY_START_BALANCE=true
