# Live runtime configuration — ONLY variables that affect ADAPTIVE_REGIME live path
# Copy to .env for live trading. Do NOT commit .env with credentials.

# --- Required ---
MT5_LOGIN=your_account_number
MT5_PASSWORD=your_password
MT5_SERVER=your_broker_server

# --- Engine selection (required explicit choice) ---
USE_ML_KERNEL=false
ADAPTIVE_REGIME_ENABLED=true
ADAPTIVE_CONFLUENCE_ONLY=true
VOL_REGIME_SKIP_TQ=true

# --- Risk (live RiskGate + LiveRiskTracker) ---
# RISK_PER_TRADE is read from live.py (default 0.005 = 0.5%)
VOL_REGIME_COOLDOWN_BARS=12
VOL_REGIME_MAX_TRADES_PER_DAY=3
VOL_REGIME_MAX_CONCURRENT=1

# --- Optional safety ---
# TRADINGBOT_ALLOW_REAL=1
# TRADINGBOT_SIGNAL_FILTER=OFF
# TRADINGBOT_WPSQF_THRESHOLD=77.56

# --- Monitoring (Phase 34A) ---
# TRADINGBOT_REJECTION_LOG=logs/rejection_events.jsonl

# =============================================================================
# INACTIVE_WITH_ADAPTIVE_REGIME — do not expect these to affect live trading
# =============================================================================
# ENABLE_RSI_FILTER=true
# ENABLE_ADX_FILTER=true
# RSI_MIN=40
# RSI_MAX=60
# ADX_MIN=15
# ADX_MAX=50
# TREND_MODEL_VERSION=v41
# PHASE22C_ENABLED=true
# PHASE22C_DECISION_MIN_CONFIDENCE=0.48
# PHASE22C_QUALITY_THRESHOLD=0.52
# PHASE22C_CALIBRATION_MIN_CONFIDENCE=0.42
# PHASE22C_RANGE_BUY_THRESHOLD=0.52
# PHASE22C_RANGE_SELL_THRESHOLD=0.48
# PHASE22C_RSI_MIN=35
# PHASE22C_RSI_MAX=65
# PHASE22C_ADX_MIN=10
# PHASE22C_ADX_MAX=55
# PHASE22C_DAILY_LOSS_FLOOR_TRADES=3
# PHASE22C_USE_DAY_START_BALANCE=true
# TRADINGBOT_SIGNAL_FILTER=WPSQF
# TRADINGBOT_WPSQF_THRESHOLD=77.56
